#!/bin/sh
# Starts the desktop portals (screen sharing, file pickers) without systemd.
sleep 1
pkill -f xdg-desktop-portal-hyprland
pkill -f xdg-desktop-portal-wlr
pkill -f xdg-desktop-portal-gtk
pkill -f "^/usr/libexec/xdg-desktop-portal$"
/usr/libexec/xdg-desktop-portal-hyprland &
sleep 2
/usr/libexec/xdg-desktop-portal &
