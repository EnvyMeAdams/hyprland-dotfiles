# Ghostty. Linked to ~/.config/ghostty/config (see README).
# Reload in an open window: Ctrl+Shift+,

# Colours follow the wallpaper: scripts/wallpaper-colors writes
# ~/.config/ghostty/themes/wallpaper and updates it when the wallpaper changes.
theme = wallpaper

font-family = JetBrains Mono
font-size = 12

# see-through, with Hyprland's blur behind it
background-opacity = 0.5
window-decoration = false
window-padding-x = 12
window-padding-y = 10

cursor-style = bar
confirm-close-surface = false
copy-on-select = clipboard
